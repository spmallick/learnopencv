# Download the same pinned images used by the notebook without requiring Python.
cmake_minimum_required(VERSION 3.16)
if(NOT DEFINED ASSETS_DIR)
  get_filename_component(ASSETS_DIR "${CMAKE_CURRENT_LIST_DIR}/../assets/downloads" ABSOLUTE)
endif()
file(MAKE_DIRECTORY "${ASSETS_DIR}")
function(fetch_asset relative_path url digest)
  set(destination "${ASSETS_DIR}/${relative_path}")
  if(EXISTS "${destination}")
    file(SHA256 "${destination}" actual)
    if(actual STREQUAL digest)
      return()
    endif()
  endif()
  get_filename_component(parent "${destination}" DIRECTORY)
  file(MAKE_DIRECTORY "${parent}")
  message(STATUS "Downloading ${relative_path}")
  file(DOWNLOAD "${url}" "${destination}.download"
    EXPECTED_HASH "SHA256=${digest}" TLS_VERIFY ON SHOW_PROGRESS STATUS status)
  list(GET status 0 code)
  if(NOT code EQUAL 0)
    message(FATAL_ERROR "Asset download failed: ${status}")
  endif()
  file(RENAME "${destination}.download" "${destination}")
endfunction()

# Read the export manifest without requiring a Python interpreter or CMake's
# newer JSON API. Each entry records a filename, byte count, and SHA-256 hash.
set(_alignment_model_dir "${CMAKE_CURRENT_LIST_DIR}/models")
file(READ "${_alignment_model_dir}/manifest.json" _alignment_model_manifest)
set(_alignment_model_names aliked_n16_dense.onnx aliked_n16_descriptor.onnx)
foreach(_layer RANGE 0 8)
  list(APPEND _alignment_model_names "lightglue_layer_${_layer}.onnx")
endforeach()
foreach(_name IN LISTS _alignment_model_names)
  if(NOT EXISTS "${_alignment_model_dir}/${_name}")
    message(FATAL_ERROR "Missing bundled native model: ${_name}")
  endif()
  string(REGEX MATCH "\"file\"[ \r\n]*:[ \r\n]*\"${_name}\"[^}]*\"sha256\"[ \r\n]*:[ \r\n]*\"([a-f0-9]+)\""
    _entry "${_alignment_model_manifest}")
  set(_expected "${CMAKE_MATCH_1}")
  string(LENGTH "${_expected}" _hash_length)
  if(NOT _hash_length EQUAL 64)
    message(FATAL_ERROR "Missing SHA-256 entry for native model: ${_name}")
  endif()
  file(SHA256 "${_alignment_model_dir}/${_name}" _actual)
  if(NOT _actual STREQUAL _expected)
    message(FATAL_ERROR "Native model SHA-256 mismatch: ${_name}")
  endif()
endforeach()
message(STATUS "Verified all 11 bundled ALIKED/LightGlue ONNX model checksums")
